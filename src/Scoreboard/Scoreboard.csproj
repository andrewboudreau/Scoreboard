<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>SharedTools.Scoreboard</AssemblyName>
		<RootNamespace>SharedTools.Scoreboard</RootNamespace>
		<TargetFramework>net11.0</TargetFramework>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Ships as a module drop (`dotnet publish -o out`, zipped and uploaded by deploy.ps1), not a NuGet package. -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />

		<!-- Compile against the contract; the module host supplies SharedTools.Web at runtime. -->
		<PackageReference Include="SharedTools.Web" Version="3.0.0" ExcludeAssets="runtime" PrivateAssets="all" />

		<PackageReference Include="Azure.Storage.Blobs" Version="12.28.0-beta.1" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
	</ItemGroup>

	<!-- wwwroot ships as files in the drop; the host serves it at /_content/Scoreboard/. -->
	<ItemGroup>
		<Content Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
