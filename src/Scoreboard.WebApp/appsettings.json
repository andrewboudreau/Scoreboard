{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Modules": {
    "Paths": {
      "scoreboard": "bin/drops/scoreboard"
    },
    "Scoreboard": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "ContainerName": "scoreboard-data"
    }
  }
}
