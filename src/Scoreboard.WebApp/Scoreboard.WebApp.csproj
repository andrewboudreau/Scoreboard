<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<ModuleDropsDir>$(MSBuildProjectDirectory)\bin\drops\</ModuleDropsDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SharedTools.Web" Version="3.0.0" />
		<PackageReference Include="SharedTools.ModuleManagement" Version="3.0.0" />
	</ItemGroup>

	<!-- Build order only: the host loads the module from its published drop, not as a reference. -->
	<ItemGroup>
		<ProjectReference Include="..\Scoreboard\Scoreboard.csproj" ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>

	<!-- After every build, publish the module to bin\drops\scoreboard (loaded through Modules:Paths:scoreboard),
	     the same shape deploy.ps1 uploads to the module host. -->
	<Target Name="PublishScoreboardDrop" AfterTargets="Build">
		<MSBuild Projects="..\Scoreboard\Scoreboard.csproj"
		         Targets="Publish"
		         Properties="Configuration=$(Configuration);NoBuild=true;PublishDir=$(ModuleDropsDir)scoreboard\" />
	</Target>

</Project>
